def run_line_comparison_test(game_configs):
    num_people = game_configs["num_people"]
    times_to_run = game_configs["times_to_run"]
    folder_path = game_configs["folder_path"]
    is_context = game_configs["is_context"]
    image_path = game_configs["image_path"]
    if isinstance(is_context, str):
        is_context = is_context.lower() in ('true', '1', 'yes', 'on')
    elif not isinstance(is_context, bool):
        is_context = bool(is_context)  # Convert other types (int, etc.) to bool

    response_list = []
    #create the save folder if it doesn't exist
    script_dir = Path(__file__).parent
    save_folder = script_dir / folder_path  
    save_folder.mkdir(parents=True, exist_ok=True)
    for i in range(times_to_run):
        response = experiment.describe_image(game_configs)
        response_list.append(response)
    experiment.save_to_csv(game_configs, response_list)
    experiment.save_to_txt(game_configs, response_list)

    print(f"Experiment completed {times_to_run} times")
    return

if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="Run two lines experiment")
    parser.add_argument("-n", "--num_people", type=int, default=0,
